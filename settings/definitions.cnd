<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<j = 'http://www.jahia.org/jahia/1.0'>
<jcr = 'http://www.jcp.org/jcr/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>
<ctpl = 'http://www.jahia.org/classic-templates/nt/1.0'>
<ctplmix = 'http://www.jahia.org/classic-templates/mix/1.0'>

// Namespaces, base mixins and the mixins shared by several types. Each content type lives next to
// its view in src/components/<Category>/<Name>/definition.cnd, with exactly this header: the
// engine merges every CND of the module at install time, and a prefix bound to two URIs fails the
// install.

// ---- Component tiers ----------------------------------------------------------------------------

// Groups every classic-templates type in the content type selector.
[ctplmix:component] > jmix:droppableContent, jmix:accessControllableContent mixin

// Can be dropped in a page's main area.
[ctplmix:pageComponent] > ctplmix:component mixin

// Can be dropped in a page's hero area (one banner at the top of the page).
[ctplmix:heroComponent] > ctplmix:component mixin

// The singleton that fills the shared header area, and the one that fills the shared footer area.
[ctplmix:headerComponent] > ctplmix:component mixin
[ctplmix:footerComponent] > ctplmix:component mixin

// ---- Areas --------------------------------------------------------------------------------------
// One area type per region, so an editor only ever sees the types that belong there.

[ctpl:heroArea] > jnt:content, jmix:list, jmix:hiddenType orderable
 + * (ctplmix:heroComponent)

[ctpl:pageArea] > jnt:content, jmix:list, jmix:hiddenType orderable
 + * (ctplmix:pageComponent)

[ctpl:headerArea] > jnt:content, jmix:list, jmix:hiddenType orderable
 + * (ctplmix:headerComponent)

[ctpl:footerArea] > jnt:content, jmix:list, jmix:hiddenType orderable
 + * (ctplmix:footerComponent)

// ---- Shared property groups ---------------------------------------------------------------------

// A link picked with Jahia's native link selector: "internal" adds jmix:internalLink (page picker,
// j:linknode), "external" adds jmix:externalLink (j:url, j:linkTitle). Both targets are i18n, so a
// link is set per language. Never declare j:linknode or j:url here. Views resolve it with
// src/lib/resolveLink.ts, which also allow-lists URL schemes.
[ctplmix:linkTo] mixin
 - j:linkType (string, choicelist[linkTypeInitializer,resourceBundle]) = 'none' autocreated indexed=no

// A single call to action: a link plus its visible label, rendered by src/lib/Cta.tsx. Reusable in
// two ways: built into a type as a supertype (hero banner, image and text, content list place the
// button in their own layout), or switched on by editors on any section (every ctplmix:sectionStyle
// type: "Call to action" in the edit form), where the view renders it after the section's content.
// A component with several actions models them as child ctpl:link nodes instead.
[ctplmix:cta] > ctplmix:linkTo mixin
 extends = ctplmix:sectionStyle
 - ctaLabel (string) i18n

// An image from the media library. Its text alternative is imageAlt when set (what the image
// means HERE, per language), else the image's own jcr:title; imageDecorative renders alt="" for an
// image that only decorates (a backdrop). Cards and quotes always treat their image as decorative:
// the link or the person's name says it all.
[ctplmix:media] mixin
 - image (weakreference, picker[type='image']) < jmix:image
 // cnd-check-ignore(redundantImageAlt): RGAA 1.3 wants the alternative that fits THIS use; the library title is the default
 - imageAlt (string) i18n
 - imageDecorative (boolean) = false autocreated

// Background of a page section, from the theme's surfaces: plain page, sunken (a quiet grey band)
// or accent (a tint of the theme's accent). Alternating surfaces gives long pages their rhythm.
[ctplmix:sectionStyle] mixin
 - ctplSurface (string, choicelist[resourceBundle]) = 'default' autocreated < 'default', 'sunken', 'accent'

// ---- Editorial content (news, articles) -----------------------------------------------------------

// Marker of the content types a ctpl:jcrQuery can list (its type picker offers the subtypes of this
// mixin, so a new listable type only has to extend it).
[ctplmix:listable] mixin

// What a news item and an article share: the teaser shown on cards, the body of the full page, the
// publication date used for sorting and display, and an image.
[ctplmix:editorialItem] > ctplmix:listable, ctplmix:media mixin
 - teaser (string, textarea) i18n
 - body (string, richtext) i18n
 - publicationDate (date, datepicker)

// ---- Page and site options ----------------------------------------------------------------------

// Optional page settings, offered on every page's edit form. ctplHideBreadcrumb removes the
// breadcrumb trail from this page only, when the site shows one.
[ctplmix:pageOptions] mixin
 extends = jnt:page
 - ctplHideFromNav (boolean) = false autocreated
 - ctplHideTitle (boolean) = false autocreated
 - ctplHideBreadcrumb (boolean) = false autocreated

// Look of the whole site, set on the site node in jContent: no deploy needed to change it.
// ctplShowBreadcrumb shows the breadcrumb trail above the content of every page except home.
[ctplmix:siteSettings] mixin
 extends = jnt:virtualsite
 - ctplTheme (string, choicelist[resourceBundle]) = 'default' autocreated < 'default', 'ocean', 'terracotta'
 - ctplColorScheme (string, choicelist[resourceBundle]) = 'auto' autocreated < 'auto', 'light', 'dark'
 - ctplShowBreadcrumb (boolean) = true autocreated
