<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<j = 'http://www.jahia.org/jahia/1.0'>
<jcr = 'http://www.jcp.org/jcr/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>
<ctpl = 'http://www.jahia.org/classic-templates/nt/1.0'>
<ctplmix = 'http://www.jahia.org/classic-templates/mix/1.0'>
<ctmd = 'http://www.jahia.org/classic-media/nt/1.0'>
<ctmdmix = 'http://www.jahia.org/classic-media/mix/1.0'>

// A search section: a search box with suggestions, facet filters (topics as a tree, tags, format,
// type, and for a network search the site) and the results of Augmented Search for the words of the
// page's `q` request parameter and the values of `topic`, `tag`, `format`, `type` and `site`, in
// the page's language, in pages of `pageSize`. Within a filter the chosen values are alternatives,
// across filters they all apply. scope "site" searches the page's site; "network" also searches
// the sites the header's network bar links to (ctpl:networkBar), so one box searches a whole group.
// Results are read as the visitor through the Augmented Search GraphQL API (on the server for the
// page, in the browser once the island has loaded); the module needs Augmented Search installed and
// the sites indexed, and shows nothing but the box otherwise. The Format filter reads the `format`
// of stories and the `sessionType` of sessions, both `facetable`: reindex after a change.
[ctmd:searchResults] > jnt:content, mix:title, ctmdmix:pageComponent, ctplmix:sectionStyle
 // cnd-check-ignore(missingI18n): a choice among fixed values, labelled in the resource bundles
 - scope (string, choicelist[resourceBundle]) = 'site' autocreated < 'site', 'network'
 - pageSize (long) = 10 autocreated < '[5,50]'
 - noResultText (string) i18n
