<?xml version="1.0" encoding="UTF-8"?>
<!--
  classic-moderation: opens moderated content (ctplmix:moderated of the classic-templates template
  set) to every visitor and publishes it once an editor accepts it, and closes it again when the
  status leaves "accepted". A small OSGi bundle, the only Java of this monorepo: a JavaScript module
  cannot react to a save.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>classic-templates-root</artifactId>
    <groupId>org.jahia.modules.javascript</groupId>
    <version>0.8.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>classic-moderation</artifactId>
  <name>Classic Moderation</name>
  <packaging>bundle</packaging>
  <description>Opens content moderated with the classic-templates template set to every visitor and publishes it once an editor accepts it</description>

  <properties>
    <jahia-depends>default</jahia-depends>
    <sonar.sources>src/main/java,pom.xml</sonar.sources>
    <sonar.tests>src/test/java</sonar.tests>
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <mockito.version>5.12.0</mockito.version>
    <!-- The Jahia API the bundle compiles against, the parent's (8.2.1.0): the lowest the code needs -->
    <jahia.server.version>8.2.1.0</jahia.server.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jahia.server</groupId>
      <artifactId>jahia-impl</artifactId>
      <version>${jahia.server.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>javax.jcr</groupId>
      <artifactId>jcr</artifactId>
      <version>2.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.cmpn</artifactId>
      <version>7.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.annotation</artifactId>
      <version>7.0.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- jahia-impl's own dependency, excluded above: mocking a JCRNodeWrapper loads commons-lang -->
    <dependency>
      <groupId>commons-lang</groupId>
      <artifactId>commons-lang</artifactId>
      <version>2.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
