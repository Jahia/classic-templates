{
 "endpoint": "/cxs/rules",
 "items": [
  {
   "itemId": "orvane-topic-streaming",
   "itemType": "rule",
   "metadata": {
    "id": "orvane-topic-streaming",
    "name": "Orvane: count reads of Streaming and distribution",
    "description": "Increments a profile counter on every view of a page or story filed under this topic.",
    "scope": "systemscope",
    "enabled": true,
    "hidden": false,
    "readOnly": false,
    "tags": [],
    "systemTags": []
   },
   "condition": {
    "type": "booleanCondition",
    "parameterValues": {
     "operator": "and",
     "subConditions": [
      {
       "type": "eventTypeCondition",
       "parameterValues": {
        "eventTypeId": "view"
       }
      },
      {
       "type": "eventPropertyCondition",
       "parameterValues": {
        "propertyName": "target.properties.pageInfo.categories",
        "comparisonOperator": "contains",
        "propertyValue": "/categories/orvane/streaming"
       }
      }
     ]
    }
   },
   "actions": [
    {
     "type": "incrementPropertyAction",
     "parameterValues": {
      "propertyName": "orvaneTopicStreaming"
     }
    }
   ],
   "raiseEventOnlyOnceForSession": false,
   "raiseEventOnlyOnce": false,
   "priority": 0
  },
