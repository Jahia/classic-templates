<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator of the classic-templates monorepo. Every package shares this version:
  - packages/template-set    the classic-templates template set (JavaScript module, .tgz)
  - packages/travel          the classic-travel module (JavaScript module, .tgz)
  - packages/prepackaged-site the classic-dev demo site as a pre-packaged project (.jar)
  - packages/prepackaged-skylantern the skylantern demo site as a pre-packaged project (.jar)
  The JavaScript packages are standalone Yarn projects: their pom.xml installs Node and Yarn,
  runs `yarn build` in the package folder and attaches dist/package.tgz.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>jahia-modules</artifactId>
    <groupId>org.jahia.modules</groupId>
    <version>8.2.1.0</version>
  </parent>
  <groupId>org.jahia.modules.javascript</groupId>
  <artifactId>classic-templates-root</artifactId>
  <name>Classic Templates Root</name>
  <version>0.7.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <description>Classic Templates monorepo: the template set, classic-travel and the pre-packaged demo sites</description>

  <scm>
    <connection>scm:git:git@github.com:Jahia/classic-templates.git</connection>
    <developerConnection>scm:git:git@github.com:Jahia/classic-templates.git</developerConnection>
    <url>scm:git:git@github.com:Jahia/classic-templates.git</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>packages/template-set</module>
    <module>packages/travel</module>
    <module>packages/prepackaged-site</module>
    <module>packages/prepackaged-skylantern</module>
  </modules>

  <properties>
    <node.version>v22.21.0</node.version>
    <yarn.version>v1.22.22</yarn.version>
    <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
    <!-- Sonar: keep the project key of the single-module days. The root module holds the pom
         files, .github and the Cypress tests; each package declares its own sources and no tests. -->
    <sonar.projectKey>org.jahia.modules.javascript:classic-templates</sonar.projectKey>
    <sonar.tests>tests</sonar.tests>
  </properties>

  <repositories>
    <repository>
      <id>jahia-public</id>
      <name>Jahia Public Repository</name>
      <url>https://devtools.jahia.com/nexus/content/groups/public</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>jahia-public</id>
      <name>Jahia Public Repository</name>
      <url>https://devtools.jahia.com/nexus/content/groups/public</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Used by the JavaScript packages: Node and Yarn in the package's target/, then yarn install and yarn build -->
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
          <configuration>
            <nodeVersion>${node.version}</nodeVersion>
            <!-- Yarn 1 only bootstraps: the root .yarnrc.yml's yarnPath hands over to the committed Yarn 4 -->
            <yarnVersion>${yarn.version}</yarnVersion>
            <installDirectory>target</installDirectory>
          </configuration>
          <executions>
            <execution>
              <id>install node and yarn</id>
              <goals>
                <goal>install-node-and-yarn</goal>
              </goals>
            </execution>
            <execution>
              <id>yarn install</id>
              <goals>
                <goal>yarn</goal>
              </goals>
            </execution>
            <execution>
              <id>yarn build</id>
              <phase>package</phase>
              <goals>
                <goal>yarn</goal>
              </goals>
              <configuration>
                <arguments>build</arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-release-plugin</artifactId>
        <configuration>
          <!-- 'clean verify/install' recomputes the yarn.lock checksums after the version bump; scm:checkin commits them -->
          <preparationGoals>-P release-prepare clean verify scm:checkin</preparationGoals>
          <completionGoals>-P release-prepare clean install scm:checkin</completionGoals>
          <releaseProfiles>release-perform</releaseProfiles>
          <useReleaseProfile>true</useReleaseProfile>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release-prepare</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-scm-plugin</artifactId>
            <configuration>
              <!-- Each JavaScript package syncs its package.json to the Maven version (see its pom.xml) -->
              <includes>packages/*/package.json,packages/*/yarn.lock</includes>
              <message>chore(release): Prepare release ${project.version}</message>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
